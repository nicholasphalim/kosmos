# Salin menjadi .env.local (tidak di-commit).

# mock = backend palsu (MSW) di browser, tanpa server. live = kirim request ke FastAPI.
NEXT_PUBLIC_API_MODE=mock
# Dipakai hanya saat NEXT_PUBLIC_API_MODE=live
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Login Google (Supabase Auth), hanya di mode live. Supabase → Project Settings → API Keys.
# Publishable key memang publik; jangan pernah menaruh secret key di sini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
