# Salin menjadi .env lalu isi. File .env tidak boleh di-commit.
# Nilai rahasia (password DB, secret key) hanya ditaruh di .env dan env Railway.

# Supabase → Connect → Session pooler (port 5432). Awalan postgresql:// otomatis diubah ke postgresql+psycopg://.
DATABASE_URL=
# Database untuk pytest. Kosongkan untuk melewati test yang butuh database.
TEST_DATABASE_URL=

# Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=kosmos-media

# Kunci token demo login, minimal 32 karakter acak.
# Contoh membuat: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_JWT_SECRET=
DEMO_MODE=true

# Pisahkan dengan koma.
CORS_ORIGINS=http://localhost:3000

STORAGE_PROVIDER=local
AI_PROVIDER=mock
WA_PROVIDER=mock
PAYMENT_PROVIDER=mock
