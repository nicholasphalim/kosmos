# Salin menjadi .env (opsional; nilai di bawah sudah menjadi default).
DATABASE_URL=sqlite:///./kosmos.db
JWT_SECRET=ganti-dengan-string-acak
DEMO_MODE=true
# Pisahkan dengan koma. Tambahkan http://<IP-laptop>:3000 untuk akses dari HP di WiFi yang sama.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
# Alamat backend yang dipakai untuk membentuk URL file upload.
PUBLIC_BASE_URL=http://localhost:8000
AI_PROVIDER=mock
WA_PROVIDER=mock
PAYMENT_PROVIDER=mock
